{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/c2/source-list.schema.json",
  "title": "GET /v1/sources 응답 — 출처 목록 (출처 등급 · 이용 조건 · 수집 명세별 마지막 수집)",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "org": { "type": "string" },
          "license_type": { "type": "string" },
          "storage_scope": { "$ref": "common.schema.json#/$defs/storage_scope" },
          "source_grade": {
            "description": "출처 등급(가이드 시트 탭 3 Q열). 아직 정하지 않았으면 null",
            "oneOf": [{ "$ref": "common.schema.json#/$defs/source_grade" }, { "type": "null" }]
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "spec_id": { "type": "string", "minLength": 1 },
                "method": { "enum": ["api", "file", "board", "rss"] },
                "evidence_kind": { "$ref": "common.schema.json#/$defs/evidence_kind" },
                "last_success_at": {
                  "description": "마지막으로 성공(ok)한 수집의 종료 시각. 한 번도 없으면 null",
                  "$ref": "common.schema.json#/$defs/nullable_date_time"
                }
              },
              "required": ["spec_id", "method", "evidence_kind", "last_success_at"],
              "additionalProperties": false
            }
          }
        },
        "required": ["source_id", "name", "org", "license_type", "storage_scope", "source_grade", "specs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "sources"],
  "additionalProperties": false
}
