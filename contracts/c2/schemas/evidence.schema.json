{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/c2/evidence.schema.json",
  "title": "GET /v1/evidence/{evidence_id} 응답 — 원문 탭",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "evidence_id": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "$ref": "common.schema.json#/$defs/evidence_kind" },
    "title": { "type": "string" },
    "source_name": { "type": "string" },
    "source_grade": { "$ref": "common.schema.json#/$defs/source_grade" },
    "license_type": { "type": "string" },
    "storage_scope": { "$ref": "common.schema.json#/$defs/storage_scope" },
    "observed_at": { "$ref": "common.schema.json#/$defs/nullable_date_time" },
    "period_start": { "type": ["string", "null"], "format": "date" },
    "period_end": { "type": ["string", "null"], "format": "date" },
    "published_at": { "$ref": "common.schema.json#/$defs/nullable_date_time" },
    "collected_at": { "$ref": "common.schema.json#/$defs/date_time" },
    "location_precision": { "$ref": "common.schema.json#/$defs/location_precision" },
    "locator": {
      "description": "판단에 쓰인 위치 (통계표 칸, 시트·행, 문장 발췌 위치)",
      "type": "object"
    },
    "display": {
      "description": "저장 범위 안에서 보여줄 내용. link_only 면 null",
      "type": ["string", "null"]
    },
    "url": { "type": ["string", "null"], "format": "uri" },
    "footnote": {
      "description": "복사용 각주: 출처명 · 자료명 · 시점 · 출처 등급 · URL · 조회일 (FR-E4)",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "title",
    "source_name",
    "source_grade",
    "license_type",
    "storage_scope",
    "observed_at",
    "period_start",
    "period_end",
    "published_at",
    "collected_at",
    "location_precision",
    "locator",
    "display",
    "url",
    "footnote"
  ],
  "additionalProperties": false,
  "if": { "properties": { "storage_scope": { "const": "link_only" } } },
  "then": { "properties": { "display": { "type": "null" } } }
}
