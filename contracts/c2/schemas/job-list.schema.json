{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/c2/job-list.schema.json",
  "title": "GET /v1/admin/jobs 응답 — 수집 이력 목록 (관리자 전용, FR-F5). 최근 시작 순",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "jobs": { "type": "array", "items": { "$ref": "job.schema.json#/$defs/job" } },
    "page": { "type": "integer", "minimum": 1 },
    "size": { "type": "integer", "minimum": 1, "maximum": 100 },
    "total": { "type": "integer", "minimum": 0 }
  },
  "required": ["schema_version", "jobs", "page", "size", "total"],
  "additionalProperties": false
}
