{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/c2/argument.schema.json",
  "title": "GET /v1/arguments/{run_id} 응답 — 근거 수요표 + 논증 카드 6칸",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "question": {
      "type": "object",
      "properties": {
        "question_id": { "$ref": "common.schema.json#/$defs/id" },
        "place_id": { "$ref": "common.schema.json#/$defs/id" },
        "place_name": { "type": "string" },
        "card_id": {
          "description": "null 이면 목록에 없는 질문(신규 카드 후보). run_status 는 unsupported (FR-A3)",
          "type": ["string", "null"]
        },
        "card_name": { "type": ["string", "null"] },
        "period_start": { "$ref": "common.schema.json#/$defs/date" },
        "period_end": { "$ref": "common.schema.json#/$defs/date" }
      },
      "required": ["question_id", "place_id", "place_name", "card_id", "card_name", "period_start", "period_end"],
      "additionalProperties": false
    },
    "card_version": { "type": ["integer", "null"], "minimum": 0 },
    "formula_version": {
      "description": "카드 판정 규칙 판. 카드가 없거나 그 카드의 판정 규칙이 아직 없으면 null",
      "type": ["string", "null"]
    },
    "taxonomy_version": { "type": "string" },
    "run_status": { "$ref": "common.schema.json#/$defs/run_status" },
    "created_at": { "$ref": "common.schema.json#/$defs/date_time" },
    "evidence_table": {
      "description": "근거 수요표. 판단보다 먼저 보여준다 (FR-B2)",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "$ref": "common.schema.json#/$defs/evidence_kind" },
          "required": { "type": "boolean" },
          "status": { "$ref": "common.schema.json#/$defs/evidence_status" },
          "count": { "type": "integer", "minimum": 0 },
          "review_pending_count": { "type": "integer", "minimum": 0 },
          "reason": { "$ref": "common.schema.json#/$defs/text_or_null" }
        },
        "required": ["kind", "required", "status", "count", "review_pending_count", "reason"],
        "additionalProperties": false
      }
    },
    "applicability": {
      "description": "카드 적용 조건(양식 B6)을 조건마다 확인한 결과(C2 v1). 카드 계약(card.schema.json) applicability 의 칸 순서(모르는 칸은 뒤). 카드 · 승인본이 없으면 빈 배열. 하나라도 passed false 면 run_status 는 unsupported. 이 칸 전에 저장된 실행은 빈 배열",
      "type": "array",
      "items": { "$ref": "#/$defs/applicability_item" }
    },
    "comparability": {
      "description": "비교 조건 4가지. 하나라도 false 면 increasing/decreasing 을 낼 수 없다 (FR-C4)",
      "type": "object",
      "properties": {
        "same_indicator": { "$ref": "#/$defs/condition" },
        "same_period_length": { "$ref": "#/$defs/condition" },
        "same_boundary": { "$ref": "#/$defs/condition" },
        "same_method": { "$ref": "#/$defs/condition" }
      },
      "required": ["same_indicator", "same_period_length", "same_boundary", "same_method"],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "value": { "$ref": "common.schema.json#/$defs/claim" },
        "label": {
          "description": "판단 배지 글자 = 승인본 rule.outcomes[].label(카드 결과 이름, 예: 청년 순유출 확대 · 비교 불가). 판정하지 않은 실행(blocked · unsupported)은 null — 화면은 run_status 로 「자료 부족」 · 「근거 부족」. 이 칸 전에 저장된 실행도 null(ready · partial 이면 화면은 이전 배지로 대신) (C2 v1)",
          "type": ["string", "null"],
          "minLength": 1
        },
        "level": { "$ref": "common.schema.json#/$defs/claim_level" },
        "text": { "$ref": "common.schema.json#/$defs/text_or_null" },
        "provenance": { "$ref": "common.schema.json#/$defs/rule_provenance" }
      },
      "required": ["value", "label", "level", "text", "provenance"],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "statistics": { "$ref": "#/$defs/refs" },
        "documents": { "$ref": "#/$defs/refs" },
        "existing_responses": { "$ref": "#/$defs/refs" },
        "denominators": { "$ref": "#/$defs/refs" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      },
      "required": ["statistics", "documents", "existing_responses", "denominators", "provenance"],
      "additionalProperties": false
    },
    "warrant": {
      "type": "object",
      "properties": {
        "text": { "$ref": "common.schema.json#/$defs/text_or_null" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      },
      "required": ["text", "provenance"],
      "additionalProperties": false
    },
    "qualifier": {
      "description": "근거 충실도. 수치 신뢰도(예: 0.82)는 출력하지 않는다 (FR-C5). 등급은 README 「근거 충실도 규칙표」로만 정한다",
      "type": "object",
      "properties": {
        "grade": { "$ref": "common.schema.json#/$defs/qualifier_grade" },
        "components": {
          "type": "object",
          "properties": {
            "a_grade_sources": { "type": "integer", "minimum": 0 },
            "ab_grade_sources": { "type": "integer", "minimum": 0 },
            "independent_evidence": { "type": "integer", "minimum": 0 },
            "latest_observed_at": { "$ref": "common.schema.json#/$defs/nullable_date_time" },
            "latest_within_one_year": { "type": "boolean" }
          },
          "required": [
            "a_grade_sources",
            "ab_grade_sources",
            "independent_evidence",
            "latest_observed_at",
            "latest_within_one_year"
          ],
          "additionalProperties": false
        },
        "formula_version": { "const": "qualifier-0.1" },
        "provenance": { "$ref": "common.schema.json#/$defs/rule_provenance" }
      },
      "required": ["grade", "components", "formula_version", "provenance"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "grade": { "const": "high" } } },
          "then": { "properties": { "components": { "$ref": "#/$defs/qualifier_high" } } }
        },
        {
          "if": { "properties": { "grade": { "const": "medium" } } },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/qualifier_medium",
                "not": { "$ref": "#/$defs/qualifier_high" }
              }
            }
          }
        },
        {
          "if": { "properties": { "grade": { "const": "low" } } },
          "then": { "properties": { "components": { "not": { "$ref": "#/$defs/qualifier_medium" } } } }
        }
      ]
    },
    "rebuttals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "status": { "$ref": "common.schema.json#/$defs/rebuttal_status" },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
          "citations": {
            "description": "반박 근거 기사(선택, 2026-11-11, S15P31C108-343): status 가 supported 이고 AI 가 기사 요약 문장을 인용했을 때만. 인용문은 그 기사 요약에 글자 그대로 있다(engine 검사). 같은 기사 같은 인용문은 한 번. 다른 상태 · 지난 실행에는 칸이 없다",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "article_id": { "description": "news_id", "type": "string", "minLength": 1 },
                "date": { "$ref": "common.schema.json#/$defs/date" },
                "quote": { "type": "string", "minLength": 1 },
                "title": {
                  "description": "기사 제목(2026-11-11 추가). 빅카인즈 원본 레코드의 제목, 못 찾으면 null",
                  "type": ["string", "null"]
                },
                "url": {
                  "description": "언론사 원문 링크(2026-11-11 추가). 화면은 새 탭으로 연다. 원본 레코드에 링크가 없으면 null",
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "evidence_id": {
                  "description": "기사의 문서 근거 ID(ev_news_<md5>). GET /v1/evidence/{evidence_id} 로 원문 위치 · 링크를 연다. 출처 등급이 없거나 원본 레코드를 못 찾으면 null",
                  "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }]
                }
              },
              "required": ["article_id", "date", "quote", "title", "url", "evidence_id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["text", "status", "provenance"],
        "additionalProperties": false
      }
    },
    "ceiling": {
      "type": "object",
      "properties": {
        "items": { "type": "array", "items": { "type": "string" } },
        "provenance": { "$ref": "common.schema.json#/$defs/rule_provenance" }
      },
      "required": ["items", "provenance"],
      "additionalProperties": false
    },
    "series": {
      "description": "화면 그림 줄(「시공간 표시 개발 명세」 5절). 질문 기간의 달마다 한 칸이고 periods · values · statuses 길이가 같다. 그림 종류는 모양이 정한다: to 가 있으면 이동, tag 가 있으면 기사 건수(확산), coordinates 가 있으면 지도, 없으면 막대. 카드가 없으면 빈 배열",
      "type": "array",
      "items": { "$ref": "#/$defs/series" }
    },
    "articles": {
      "description": "근거 기사 목록(명세 5 · 6절). 카드 태그가 있고 질문 지역 · 기간 안인 기사. 기사는 series 가 아니라 여기로 보낸다",
      "type": "array",
      "items": { "$ref": "#/$defs/article" }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "question",
    "card_version",
    "formula_version",
    "taxonomy_version",
    "run_status",
    "created_at",
    "evidence_table",
    "applicability",
    "comparability",
    "claim",
    "data",
    "warrant",
    "qualifier",
    "rebuttals",
    "ceiling",
    "series",
    "articles"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "question": { "properties": { "card_id": { "const": null } } } } },
      "then": {
        "properties": {
          "run_status": { "const": "unsupported" },
          "card_version": { "const": null },
          "applicability": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "run_status": { "enum": ["blocked", "unsupported"] } } },
      "then": {
        "properties": {
          "claim": { "properties": { "value": { "const": "insufficient" }, "label": { "const": null } } }
        }
      }
    },
    {
      "description": "카드 적용 조건을 하나라도 못 채우면 실행하지 않는다(양식 B6)",
      "if": {
        "properties": {
          "applicability": { "contains": { "properties": { "passed": { "const": false } }, "required": ["passed"] } }
        },
        "required": ["applicability"]
      },
      "then": { "properties": { "run_status": { "const": "unsupported" } } }
    },
    {
      "if": {
        "properties": { "claim": { "properties": { "value": { "enum": ["increasing", "decreasing"] } } } }
      },
      "then": {
        "properties": {
          "comparability": {
            "properties": {
              "same_indicator": { "$ref": "#/$defs/passed" },
              "same_period_length": { "$ref": "#/$defs/passed" },
              "same_boundary": { "$ref": "#/$defs/passed" },
              "same_method": { "$ref": "#/$defs/passed" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "lon_lat": {
      "type": "array",
      "prefixItems": [{ "type": ["number", "null"] }, { "type": ["number", "null"] }],
      "minItems": 2,
      "maxItems": 2
    },
    "series": {
      "type": "object",
      "properties": {
        "indicator_id": { "type": "string" },
        "place_id": { "$ref": "common.schema.json#/$defs/id" },
        "station_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "coordinates": { "oneOf": [{ "$ref": "#/$defs/lon_lat" }, { "type": "null" }] },
        "from": { "$ref": "common.schema.json#/$defs/id" },
        "to": { "$ref": "common.schema.json#/$defs/id" },
        "to_name": { "type": ["string", "null"] },
        "from_coordinates": { "$ref": "#/$defs/lon_lat" },
        "to_coordinates": { "$ref": "#/$defs/lon_lat" },
        "tag": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "periods": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
        "values": { "type": "array", "items": { "type": ["number", "null"] } },
        "statuses": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence_status" } },
        "baseline": {
          "description": "그래프 기준선(선택, 2026-11-06): 기준 값과 그 위 · 아래의 뜻. 실행이 쓴 카드 승인본 claim_items[].sign_words 가 있는 지표면 { value: 0, above: positive, below: negative }(C1 순이동: 0 · 순유입 · 순유출). 값은 부호 그대로",
          "type": "object",
          "properties": {
            "value": { "type": "number" },
            "above": { "type": "string", "minLength": 1 },
            "below": { "type": "string", "minLength": 1 }
          },
          "required": ["value", "above", "below"],
          "additionalProperties": false
        }
      },
      "required": ["unit", "periods", "values", "statuses"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["indicator_id", "place_id", "station_id", "name", "coordinates"] },
        { "required": ["indicator_id", "from", "to", "to_name", "from_coordinates", "to_coordinates"] },
        { "required": ["tag", "place_id", "name", "coordinates"] }
      ]
    },
    "article": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "$ref": "common.schema.json#/$defs/date" },
        "place_id": { "$ref": "common.schema.json#/$defs/id" },
        "point": { "oneOf": [{ "$ref": "#/$defs/lon_lat" }, { "type": "null" }] },
        "precision": { "$ref": "common.schema.json#/$defs/location_precision" },
        "summary": { "type": ["string", "null"] },
        "place_name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" },
        "evidence_id": {
          "description": "기사의 문서 근거 ID(선택, 2026-11-09): ev_news_<md5(obs_key|content_hash)>. GET /v1/evidence/{evidence_id} 로 근거 상세를 연다. 출처 등급이 없거나 원본 레코드를 못 찾으면 null, 지난 실행 결과에는 칸이 없다",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }]
        },
        "source_grade": {
          "description": "기사 출처 등급(선택, 2026-11-09). evidence_id 근거의 등급(빅카인즈 C). evidence_id 가 null 이면 null",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/source_grade" }, { "type": "null" }]
        }
      },
      "required": ["id", "date", "place_id", "point", "precision", "summary", "place_name", "url"],
      "additionalProperties": false
    },
    "applicability_item": {
      "type": "object",
      "properties": {
        "condition": {
          "description": "승인본 applicability 의 칸 이름(place_level · min_complete_years · min_stations · population). README 「적용 조건」",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "description": "화면 문구(예: 시군구 단위 · 완전한 연 값 3개 이상 · 대상: 청년 19–39세)",
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "description": "true 충족 · false 못 채움 · null 확인하지 못함(판정 전에 멈춤) 또는 표시만 하는 조건(대상)",
          "type": ["boolean", "null"]
        },
        "note": { "$ref": "common.schema.json#/$defs/text_or_null" }
      },
      "required": ["condition", "label", "passed", "note"],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "passed": { "type": ["boolean", "null"] },
        "note": { "$ref": "common.schema.json#/$defs/text_or_null" }
      },
      "required": ["passed", "note"],
      "additionalProperties": false
    },
    "passed": { "properties": { "passed": { "const": true } } },
    "refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence_ref" } },
    "qualifier_high": {
      "description": "qualifier-0.1 상: A등급 출처 2 이상 + 독립 근거 3 이상 + 최신 근거 1년 이내 (PRD 7.3)",
      "properties": {
        "a_grade_sources": { "minimum": 2 },
        "independent_evidence": { "minimum": 3 },
        "latest_within_one_year": { "const": true }
      }
    },
    "qualifier_medium": {
      "description": "qualifier-0.1 중 이상: A 또는 B등급 출처 1 이상 + 독립 근거 2 이상 (PRD 7.3)",
      "properties": {
        "ab_grade_sources": { "minimum": 1 },
        "independent_evidence": { "minimum": 2 }
      }
    }
  }
}
