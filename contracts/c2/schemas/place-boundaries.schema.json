{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/c2/place-boundaries.schema.json",
  "title": "GET /v1/places/{place_id}/boundaries 응답",
  "description": "GeoJSON FeatureCollection(RFC 7946, WGS84 [경도, 위도]). 시군구를 주면 그 시군구 경계가 먼저, 이어서 그 안 행정동(place_id 순). 행정동을 주면 그 행정동 하나. 경계가 없는 place(측정소 · 시도)는 빈 features. 경계는 10 m 단순화라 맞닿은 선이 몇 m 어긋날 수 있다(contracts/p3 「경계」)",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "required": ["schema_version", "type", "features"],
  "additionalProperties": false,
  "$defs": {
    "feature": {
      "type": "object",
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "geometry": { "$ref": "#/$defs/multi_polygon" },
        "properties": {
          "type": "object",
          "properties": {
            "place_id": { "$ref": "common.schema.json#/$defs/id" },
            "name": { "type": "string" },
            "level": { "enum": ["sigungu", "emd"] },
            "parent_id": { "type": ["string", "null"] },
            "source": { "description": "경계 출처. sgis_hadmarea = 통계청 SGIS 행정구역 경계", "enum": ["sgis_hadmarea"] },
            "source_year": { "description": "경계 기준 연도", "type": "integer" }
          },
          "required": ["place_id", "name", "level", "parent_id", "source", "source_year"],
          "additionalProperties": false
        }
      },
      "required": ["type", "id", "geometry", "properties"],
      "additionalProperties": false
    },
    "multi_polygon": {
      "type": "object",
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "다각형 하나 = 바깥 고리 + 구멍 고리들",
            "type": "array",
            "minItems": 1,
            "items": {
              "description": "닫힌 고리(처음 점 = 끝 점)",
              "type": "array",
              "minItems": 4,
              "items": { "$ref": "#/$defs/position" }
            }
          }
        }
      },
      "required": ["type", "coordinates"],
      "additionalProperties": false
    },
    "position": {
      "description": "[경도, 위도] (우리 지역 범위)",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 124, "maximum": 132 },
        { "type": "number", "minimum": 33, "maximum": 39 }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
