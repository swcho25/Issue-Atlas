{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/c2/question-list.schema.json",
  "title": "GET /v1/questions 응답 — 내 질문 목록 (로그인한 사용자가 저장한 질문, 최근 순)",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": { "$ref": "common.schema.json#/$defs/id" },
          "place_id": { "$ref": "common.schema.json#/$defs/id" },
          "place_name": { "type": "string" },
          "card_id": { "description": "신규 카드 후보면 null", "type": ["string", "null"] },
          "card_name": { "type": ["string", "null"] },
          "period_start": { "$ref": "common.schema.json#/$defs/date" },
          "period_end": { "$ref": "common.schema.json#/$defs/date" },
          "created_at": { "$ref": "common.schema.json#/$defs/date_time" },
          "run_id": {
            "description": "이 질문의 마지막 실행. 결과 화면은 GET /v1/arguments/{run_id}",
            "$ref": "common.schema.json#/$defs/id"
          },
          "run_status": { "$ref": "common.schema.json#/$defs/run_status" },
          "claim": { "$ref": "common.schema.json#/$defs/claim" }
        },
        "required": [
          "question_id",
          "place_id",
          "place_name",
          "card_id",
          "card_name",
          "period_start",
          "period_end",
          "created_at",
          "run_id",
          "run_status",
          "claim"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "questions"],
  "additionalProperties": false
}
