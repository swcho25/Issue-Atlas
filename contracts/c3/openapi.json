  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "CreateCard": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^[A-H][0-9]{1,3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parent_question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "card_id",
          "name",
          "domain",
          "parent_question"
        ]
      },
      "SaveDraft": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "spec": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "expected_revision",
          "spec"
        ]
      },
      "Approve": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "expected_revision",
          "reason"
        ]
      },
      "CardDraft": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "legacy",
              "candidate",
              "card",
              "on_hold"
            ]
          },
          "card_version": {
            "type": "integer",
            "minimum": 0
          },
          "current_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "draft_revision": {
            "type": "integer",
            "minimum": 0
          },
          "draft_spec": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "card_id",
          "status",
          "card_version",
          "current_version",
          "draft_revision",
          "draft_spec"
        ]
      },
      "Check": {
        "type": "object",
        "properties": {
          "check_no": {
            "type": "integer",
            "minimum": 0
          },
          "ok": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "check_no",
          "ok",
          "label"
        ]
      },
      "Validation": {
        "type": "object",
        "properties": {
          "draft_revision": {
            "type": "integer",
            "minimum": 0
          },
          "valid": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          }
        },
        "required": [
          "draft_revision",
          "valid",
          "checks"
        ]
      },
      "Version": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "spec": {
            "type": "object",
            "additionalProperties": true
          },
          "draft_revision": {
            "type": "integer",
            "minimum": 0
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "card_id",
          "version",
          "spec",
          "draft_revision",
          "approved_by",
          "approved_at"
        ]
      },
      "Revision": {
        "type": "object",
        "properties": {
          "revision_id": {
            "type": "integer",
