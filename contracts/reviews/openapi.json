          "409": {
            "description": "Conflict or data write not ready"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/admin/reviews/{id}/decisions": {
