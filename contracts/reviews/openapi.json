{
  "openapi": "3.1.0",
  "info": {
    "title": "IssueAtlas review API",
    "version": "0.1.0",
    "description": "S15P31C108-216. 자료·소스 수정은 제안 보관만 지원. 기존 데이터에 반영하지 않음. ADMIN 경로는 ADMIN, 모든 쓰기는 X-XSRF-TOKEN 필수. 카드 수정은 C3 지정 승인 요청으로 연결."
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/v1/review-requests": {
      "post": {
        "operationId": "reportReview",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or data write not ready"
          }
        },
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submit"
              }
            }
          }
        }
      }
    },
    "/v1/admin/reviews": {
      "post": {
        "operationId": "registerReview",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or data write not ready"
          }
        },
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submit"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listReviews",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or data write not ready"
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "on_hold",
                "resolved",
                "rejected",
                "approval_pending"
              ]
            }
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "admin",
                "local_import",
                "model"
              ]
            }
          },
          {
            "name": "target_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "news_event",
                "normalized_record",
                "press_release",
                "source",
                "card"
              ]
            }
          },
          {
            "name": "issue_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "location",
                "classification",
                "duplicate",
                "value",
                "wording",
                "metadata",
                "other"
              ]
            }
          },
          {
            "name": "card_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/v1/admin/reviews/{id}": {
      "get": {
