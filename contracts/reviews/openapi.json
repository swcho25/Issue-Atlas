          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or data write not ready"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decide"
              }
            }
          }
        }
      }
    },
    "/v1/admin/changes": {
      "get": {
        "operationId": "listChanges",
