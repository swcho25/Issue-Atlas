  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Submit": {
        "type": "object",
        "properties": {
          "target_type": {
            "type": "string",
            "enum": [
              "news_event",
              "normalized_record",
              "press_release",
              "source",
              "card"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "issue_type": {
            "type": "string",
            "enum": [
              "location",
              "classification",
              "duplicate",
              "value",
              "wording",
              "metadata",
              "other"
            ]
          },
          "card_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "proposed_value": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "target_type",
          "target_id",
          "issue_type",
          "reason"
        ],
        "additionalProperties": false
      },
      "Review": {
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "admin",
              "local_import",
              "model"
            ]
          },
          "target_type": {
            "type": "string",
            "enum": [
              "news_event",
              "normalized_record",
              "press_release",
              "source",
              "card"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "issue_type": {
            "type": "string",
            "enum": [
              "location",
              "classification",
              "duplicate",
              "value",
              "wording",
              "metadata",
              "other"
            ]
          },
          "card_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "proposed_value": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "submitted_value": {
            "type": "object"
          },
          "submitted_by": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "on_hold",
              "resolved",
              "rejected",
              "approval_pending"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "approval_request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "review_id",
          "origin",
          "target_type",
          "target_id",
          "issue_type",
          "card_id",
          "reason",
          "proposed_value",
          "submitted_value",
          "submitted_by",
          "status",
          "revision",
          "approval_request_id",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "review_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "on_hold",
              "resolved",
              "rejected",
              "approval_pending"
            ]
          }
        },
        "required": [
          "review_id",
          "status"
        ],
        "additionalProperties": false
      },
      "Detail": {
        "type": "object",
        "properties": {
          "request": {
            "$ref": "#/components/schemas/Review"
          },
          "current_value": {
            "type": "object"
          },
          "proposable_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editable_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "record",
              "source",
              "card"
            ]
          },
          "approval_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pending",
                  "on_hold",
                  "approved",
                  "rejected"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "supported_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "confirm",
                "correct",
                "hold",
                "reject"
              ]
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          }
        },
        "required": [
          "request",
          "current_value",
          "proposable_fields",
          "editable_fields",
          "scope",
          "approval_status",
          "supported_actions",
          "decisions"
        ],
        "additionalProperties": false
      },
      "Change": {
        "type": "object",
        "properties": {
          "change_id": {
            "type": "string"
          },
          "review_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_type": {
            "type": "string",
            "enum": [
              "news_event",
              "normalized_record",
              "press_release",
              "source",
              "card"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "correct",
              "hold",
              "reject",
              "approve"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "record",
              "source",
              "card"
            ]
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "actor_email": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "before_value": {
            "type": "object"
          },
          "after_value": {
            "type": "object"
          },
          "revision": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "change_id",
          "review_id",
          "target_type",
          "target_id",
          "action",
          "scope",
          "actor_id",
          "actor_email",
          "reason",
          "before_value",
          "after_value",
          "revision",
          "created_at"
        ],
        "additionalProperties": false
      },
      "ReviewPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Review"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "additionalProperties": false
      },
      "ChangePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
        ],
        "additionalProperties": false
      },
      "Decide": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "correct",
              "hold",
              "reject"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "record",
              "source",
              "card"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expected_value": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "approver_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "expected_revision",
          "action",
          "scope",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
}
