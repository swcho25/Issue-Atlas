{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/cards/card.schema.json",
  "title": "카드 설계도 v0.2",
  "description": "이슈 카드 표준 개발 양식 v1.1(회사 노션)의 칸을 코드 키로 옮긴 것. 지역 · 기간을 넣어 돌린 결과는 적지 않는다",
  "type": "object",
  "properties": {
    "card_id": { "description": "A1", "type": "string", "pattern": "^[A-H][0-9]+$" },
    "name": { "description": "A2", "type": "string", "minLength": 1 },
    "parent_question": { "description": "A3", "type": "string", "minLength": 1 },
    "domain": { "description": "A4", "type": "string", "minLength": 1 },
    "st_type": { "description": "A5 그림 이름표. 「확산형」은 2026-11-01 결정으로 「관측 순서」 그림이 됐고 카드 유형으로 쓰지 않는다", "type": "array", "minItems": 1, "items": { "enum": ["분포형", "변화형", "이동형", "사건형"] }, "uniqueItems": true },
    "status": { "description": "A6 후보 · 카드 · 보류", "enum": ["candidate", "card", "hold"] },
    "card_version": { "description": "A6. DB card.card_version 과 같다", "type": "integer", "minimum": 0 },
    "inclusion": { "description": "A7", "$ref": "#/$defs/texts" },
    "exclusion": { "description": "A7", "$ref": "#/$defs/texts" },
    "claim_template": { "description": "B1", "type": "string", "pattern": "\\{판정값\\}" },
    "claim_items": {
      "description": "B2 계산할 지표 1–3개. 판정은 role = main 하나만 한다. related 는 그림만",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": { "indicator_id": { "type": "string" }, "role": { "enum": ["main", "related"] } },
        "required": ["indicator_id", "role"],
        "additionalProperties": false
      },
      "contains": { "properties": { "role": { "const": "main" } } },
      "minContains": 1,
      "maxContains": 1
    },
    "comparability": {
      "description": "B3 무엇이 같아야 하는가. 실제로 같은지는 실행 때 판정한다",
      "type": "object",
      "properties": {
        "same_indicator": { "type": "string", "minLength": 1 },
        "same_period_length": { "type": "string", "minLength": 1 },
        "same_boundary": { "type": "string", "minLength": 1 },
        "same_method": { "type": "string", "minLength": 1 }
      },
      "required": ["same_indicator", "same_period_length", "same_boundary", "same_method"],
      "additionalProperties": false
    },
    "rule": { "description": "B4", "$ref": "#/$defs/rule" },
    "max_claim_level": { "description": "B5", "enum": ["observed_fact", "calculated", "associated"] },
    "applicability": {
      "description": "B6 못 채우면 실행하지 않는다(unsupported)",
      "type": "object",
      "properties": {
        "place_level": { "enum": ["sigungu", "station"] },
        "min_complete_years": { "type": "integer", "minimum": 1 },
        "min_stations": { "type": "integer", "minimum": 1 },
        "population": { "type": "string" }
      },
      "required": ["place_level", "min_complete_years"],
      "additionalProperties": false
    },
    "evidence": {
      "description": "C1–C4 근거 4종마다 어느 원천을 쓰는가",
      "type": "object",
      "properties": {
        "statistics": { "$ref": "#/$defs/sources" },
        "documents": { "$ref": "#/$defs/sources" },
        "existing_responses": { "$ref": "#/$defs/sources" },
        "denominators": { "$ref": "#/$defs/sources" }
      },
      "required": ["statistics", "documents", "existing_responses", "denominators"],
      "additionalProperties": false
    },
    "expected_gaps": {
      "description": "C5 지역과 무관하게 미리 아는 빈칸",
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "what": { "type": "string" }, "status": { "enum": ["not_published", "not_collected", "license_blocked"] } },
        "required": ["what", "status"],
        "additionalProperties": false
      }
    },
    "required_for_claim": {
      "description": "C6 없으면 판단하지 않는다(required) · 표시만(optional)",
      "type": "object",
      "properties": {
        "statistics": { "$ref": "#/$defs/requirement" },
        "documents": { "$ref": "#/$defs/requirement" },
        "existing_responses": { "$ref": "#/$defs/requirement" },
        "denominators": { "$ref": "#/$defs/requirement" }
      },
      "required": ["statistics", "documents", "existing_responses", "denominators"],
      "additionalProperties": false
    },
    "warrant": {
      "description": "D1",
      "type": "object",
      "properties": { "status": { "$ref": "#/$defs/approval_status" }, "text": { "type": "string", "minLength": 1 } },
      "required": ["status", "text"],
      "additionalProperties": false
    },
    "rebuttals": {
      "description": "D2 2개 이상",
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/approval_status" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": { "id": { "type": "string", "pattern": "^[A-H][0-9]+-R[0-9]+$" }, "text": { "type": "string", "minLength": 1 } },
            "required": ["id", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "items"],
      "additionalProperties": false
    },
    "ceiling": { "description": "D3 이 판단으로 말할 수 없는 것", "$ref": "#/$defs/texts" },
    "map_mode": { "description": "E1", "type": "string", "minLength": 1 },
    "legend_text": { "description": "E2 고정 문구", "$ref": "#/$defs/texts" },
    "forbidden_terms": { "description": "E3", "$ref": "#/$defs/texts" },
    "keywords": { "description": "F1", "$ref": "#/$defs/texts" },
    "approval": {
      "description": "F2",
      "type": "object",
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date" },
        "approved_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "source": { "type": "string", "minLength": 1 }
      },
      "required": ["approved_by", "approved_at", "approved_fields", "source"],
      "additionalProperties": false
    }
  },
  "required": [
    "card_id", "name", "parent_question", "domain", "st_type", "status", "card_version", "inclusion", "exclusion",
    "claim_template", "claim_items", "comparability", "rule", "max_claim_level", "applicability", "evidence",
    "expected_gaps", "required_for_claim", "warrant", "rebuttals", "ceiling", "map_mode", "legend_text",
    "forbidden_terms", "keywords", "approval"
  ],
  "additionalProperties": false,
  "$defs": {
    "texts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requirement": { "enum": ["required", "optional"] },
    "approval_status": { "description": "draft = 대표 초안, approved = 승인", "enum": ["draft", "approved"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spec_id": { "description": "source_spec.spec_id. 아직 등록 전이면 null + note", "type": ["string", "null"] },
          "indicator_id": { "description": "지표 사전 ID", "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["spec_id"],
        "if": { "properties": { "spec_id": { "type": "null" } } },
        "then": { "required": ["note"] },
        "additionalProperties": false
      }
    },
    "rule": {
      "type": "object",
      "properties": {
        "rule_id": { "description": "판정 코드가 구현하는 규칙 모듈", "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "formula_version": { "description": "C2 argument.formula_version 에 그대로 나간다", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]+\\.[0-9]+$" },
        "indicator_id": { "description": "판정하는 지표. claim_items 의 main 과 같다", "type": "string" },
        "min_years": { "type": "integer", "minimum": 1 },
        "thresholds": { "type": "object" },
        "outcomes": {
          "description": "위에서부터 처음 맞는 것. 마지막은 otherwise",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "when": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "description": "화면 판정값 문구", "type": "string", "minLength": 1 },
              "claim": { "description": "C2 claim.value", "enum": ["increasing", "decreasing", "unclear", "insufficient"] },
              "meaning": { "type": "string", "minLength": 1 }
            },
            "required": ["when", "label", "claim", "meaning"],
            "additionalProperties": false
          }
        }
      },
      "required": ["rule_id", "formula_version", "indicator_id", "min_years", "thresholds", "outcomes"],
      "additionalProperties": false
    }
  }
}
