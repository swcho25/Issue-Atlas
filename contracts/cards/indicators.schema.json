{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://issue-atlas.c108/contracts/cards/indicators.schema.json",
  "title": "지표 사전 v0.3",
  "description": "카드가 판정 · 그림에 쓰는 지표 한 행 = 이름 · 단위 · 주기 · 월 → 연 묶는 법(roll) · 원천. 연령 · 성별은 지표 ID 에 넣는다(_19_39). C3 저장(indicator.definition)은 이 행을 그대로 쓴다",
  "type": "object",
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "decided_at": { "type": "string", "format": "date" },
    "indicators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/indicator" } }
  },
  "required": ["version", "decided_at", "indicators"],
  "additionalProperties": false,
  "$defs": {
    "indicator": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "period_type": { "description": "원천 주기. M 월 · Y 연", "enum": ["M", "Y"] },
        "place_level": { "enum": ["sido", "sigungu", "emd", "station"] },
        "roll": { "$ref": "#/$defs/roll" },
        "value_direction": { "description": "값이 커지면 무슨 뜻인가. 판정 방향과 다를 수 있다", "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "properties": {
            "spec_id": { "description": "source_spec.spec_id", "type": "string", "minLength": 1 },
            "c1_indicator_id": { "description": "수집기가 C1 레코드에 넣는 indicator_id", "type": "string", "minLength": 1 },
            "locator": {
              "description": "같은 c1_indicator_id 안에서 이 지표를 고르는 원천 코드. 예: SP01 locator.C3 = 905(19–39세). 코드 목록이면 그 코드 값들의 합(예: SP10 C2 1세별 19–39세)",
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" }, "minItems": 2, "uniqueItems": true }
                ]
              }
            }
          },
          "required": ["spec_id", "c1_indicator_id", "locator"],
          "additionalProperties": false
        },
        "cards": { "description": "이 지표를 쓰는 카드(claim_items · evidence). 승인본에서는 C3 card_claim_item · card_evidence_bind 가 원본", "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "added_by_card": { "description": "이 지표를 사전에 넣은 카드(C3 indicator.added_by_card). 그 카드가 승인될 때 검수된다. 쓰는 카드(cards)와 다르다", "$ref": "#/$defs/card_id" },
        "target": { "description": "적용 대상 설명(예: 청년 19–39세). 설명용 — 연령의 원본은 지표 ID", "type": "string", "minLength": 1 },
        "shape": {
          "description": "값 모양. 없으면 value. value 원자료 값 하나 · flow 출발 → 도착 이동량 · ratio 다른 두 지표의 비율 · grade_days 기준 지표가 cut 을 넘은 날 수",
          "enum": ["value", "flow", "ratio", "grade_days"]
        },
        "numerator_id": { "description": "ratio 분자 지표 ID", "$ref": "#/$defs/indicator_id" },
        "denominator_id": { "description": "ratio 분모 지표 ID", "$ref": "#/$defs/indicator_id" },
        "multiplier": { "description": "ratio 배수(100 · 1000)", "type": "number", "exclusiveMinimum": 0 },
        "base_id": { "description": "grade_days 기준 지표 ID", "$ref": "#/$defs/indicator_id" },
        "cut": { "description": "grade_days 경계값(기준 지표 단위). 이 값을 넘은 날을 센다", "type": "number" }
      },
      "required": ["id", "label", "unit", "period_type", "place_level", "roll", "value_direction", "source", "cards"],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "ratio 면 분자 · 분모 · 배수가 있고, 아니면 없다(C3 저장 트리거와 같은 조건)",
          "if": { "properties": { "shape": { "const": "ratio" } }, "required": ["shape"] },
          "then": { "required": ["numerator_id", "denominator_id", "multiplier"] },
          "else": { "not": { "anyOf": [{ "required": ["numerator_id"] }, { "required": ["denominator_id"] }, { "required": ["multiplier"] }] } }
        },
        {
          "description": "grade_days 면 기준 지표 · 경계값이 있고, 아니면 없다",
          "if": { "properties": { "shape": { "const": "grade_days" } }, "required": ["shape"] },
          "then": { "required": ["base_id", "cut"] },
          "else": { "not": { "anyOf": [{ "required": ["base_id"] }, { "required": ["cut"] }] } }
        }
      ]
    },
    "indicator_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "card_id": { "type": "string", "pattern": "^[A-H][0-9]+$" },
    "roll": {
      "description": "판정 안에서 월 → 연. 못 채우면 그 해는 null. 화면 series 는 묶지 않는다",
      "oneOf": [
        {
          "description": "합계. min_months 개월이 모두 있을 때만(순이동 · 이동)",
          "type": "object",
          "properties": { "method": { "const": "sum" }, "min_months": { "const": 12 } },
          "required": ["method", "min_months"],
          "additionalProperties": false
        },
        {
          "description": "평균. 유효한 달이 min_months 개 이상일 때만(대기)",
          "type": "object",
          "properties": { "method": { "const": "mean" }, "min_months": { "type": "integer", "minimum": 1, "maximum": 12 } },
          "required": ["method", "min_months"],
          "additionalProperties": false
        },
        {
          "description": "연말 값(인구)",
          "type": "object",
          "properties": { "method": { "const": "end_of_period" } },
          "required": ["method"],
          "additionalProperties": false
        }
      ]
    }
  }
}
