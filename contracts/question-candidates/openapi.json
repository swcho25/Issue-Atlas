{
  "openapi": "3.1.0",
  "info": {
    "title": "Issue Atlas 관리자 새 이슈 후보 목록 API",
    "version": "0.1.0",
    "description": "새 질문에서 카드 없이 저장한 질문(신규 카드 후보)을 관리자가 보는 읽기 전용 목록. S15P31C108-345"
  },
  "paths": {
    "/v1/admin/question-candidates": {
      "get": {
        "summary": "새 이슈 후보 목록",
        "parameters": [
          { "name": "place_id", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "접수 최신 순 목록",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuestionCandidatePage" } } }
          },
          "400": { "description": "잘못된 place_id · page · size (../http-errors)" },
          "401": { "description": "로그인 안 함" },
          "403": { "description": "ADMIN 아님" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QuestionCandidatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "total", "page", "size"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/QuestionCandidate" } },
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "size": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "QuestionCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "place_id",
          "place_name",
          "period_start",
          "period_end",
          "issue_name",
          "reason",
          "sentence",
          "raw_text",
          "asked_by",
          "created_at"
        ],
        "properties": {
          "question_id": { "type": "string", "minLength": 1 },
          "place_id": { "type": "string", "minLength": 1 },
          "place_name": { "type": "string" },
          "period_start": { "type": "string", "format": "date" },
          "period_end": { "type": "string", "format": "date" },
          "issue_name": { "type": ["string", "null"], "minLength": 1, "description": "「이슈 이름:」 줄의 값" },
          "reason": { "type": ["string", "null"], "minLength": 1, "description": "「궁금한 까닭:」 줄의 값" },
          "sentence": { "type": ["string", "null"], "minLength": 1, "description": "두 머리말 줄을 뺀 나머지 줄" },
          "raw_text": { "type": ["string", "null"], "description": "저장된 원문 그대로" },
          "asked_by": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/QuestionCandidateAsker" }]
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "QuestionCandidateAsker": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "email"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    }
  }
}
