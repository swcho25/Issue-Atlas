{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C1 공통 메타 필드 계약 v0.1",
  "description": "수집(P1) → 정제·지역·시간·분류(P2~P4). 값 1개 = 레코드 1개.",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string"
    },
    "spec_id": {
      "type": "string"
    },
    "raw_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_at_source": {
      "enum": [
        "source",
        "parsed",
        "posted_at",
        null
      ]
    },
    "observed_period_type": {
      "enum": [
        "H",
        "D",
        "M",
        "Q",
        "Y",
        "instant",
        "none"
      ]
    },
    "observed_period_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "place_code_raw": {
      "type": "string"
    },
    "place_code_system": {
      "enum": [
        "kosis",
        "airkorea_station",
        "airkorea_station_name",
        "bjd",
        "sgis"
      ]
    },
    "place_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "place_map_status": {
      "enum": [
        "mapped",
        "ambiguous",
        "unmapped"
      ]
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 124,
              "maximum": 132
            },
            {
              "type": "number",
              "minimum": 33,
              "maximum": 39
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "location_precision": {
      "enum": [
        "exact",
        "address",
        "admin_centroid",
        "none"
      ]
    },
    "geometry_role": {
      "enum": [
        "event",
        "affected_area",
        "office",
        "station",
        null
      ]
    },
    "indicator_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_reason": {
      "enum": [
        "not_published",
        "not_collected",
        "license_blocked",
        null
      ]
    },
    "is_provisional": {
      "type": "boolean"
    },
    "locator": {
      "type": "object",
      "additionalProperties": true
    },
    "dedup_key": {
      "type": "string"
    },
    "license_type": {
      "type": "string"
    },
    "storage_scope": {
      "enum": [
        "full",
        "metadata",
        "link_only"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "collector_version": {
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "spec_id",
    "content_hash",
    "collected_at",
    "published_at",
    "observed_at",
    "observed_at_source",
    "observed_period_type",
    "observed_period_start",
    "observed_period_end",
    "place_code_raw",
    "place_code_system",
    "place_id",
    "place_map_status",
    "geometry",
    "location_precision",
    "geometry_role",
    "indicator_id",
    "value",
    "unit",
    "missing_reason",
    "is_provisional",
    "locator",
    "dedup_key",
    "license_type",
    "storage_scope",
    "run_id",
    "collector_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "indicator_id": {
            "type": "string"
          }
        },
        "required": [
          "indicator_id"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "value": {
                "type": "number"
              },
              "missing_reason": {
                "type": "null"
              }
            },
            "required": [
              "value",
              "missing_reason"
            ]
          },
          {
            "properties": {
              "value": {
                "type": "null"
              },
              "missing_reason": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "missing_reason"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "geometry": {
            "type": "null"
          }
        },
        "required": [
          "geometry"
        ]
      },
      "then": {
        "properties": {
          "location_precision": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observed_period_type": {
            "not": {
              "const": "none"
            }
          }
        },
        "required": [
          "observed_period_type"
        ]
      },
      "then": {
        "properties": {
          "observed_period_start": {
            "type": "string"
          },
          "observed_period_end": {
            "type": "string"
          }
        },
        "required": [
          "observed_period_start",
          "observed_period_end"
        ]
      }
    },
    {
      "anyOf": [
        {
          "properties": {
            "raw_url": {
              "type": "string"
            }
          },
          "required": [
            "raw_url"
          ]
        },
        {
          "properties": {
            "file_name": {
              "type": "string"
            }
          },
          "required": [
            "file_name"
          ]
        }
      ]
    }
  ]
}
