{
  "permissions": {
    "deny": [
      "Read(.env)", "Read(**/.env)", "Read(.env.*.local)", "Read(**/.env.*.local)",
      "Read(.env.local)", "Read(**/.env.local)", "Read(.env.production)", "Read(**/.env.production)",
      "Read(**/*.pem)", "Read(**/*.key)", "Read(**/*.p12)", "Read(**/*.jks)",
      "Edit(.env)", "Edit(**/.env)", "Edit(.env.*.local)", "Edit(**/.env.*.local)",
      "Edit(.env.local)", "Edit(**/.env.local)", "Edit(.env.production)", "Edit(**/.env.production)",
      "Edit(**/*.pem)", "Edit(**/*.key)", "Edit(**/*.p12)", "Edit(**/*.jks)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push origin main*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-file.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/plan-reminder.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
