# Root-managed /etc/issueatlas/collector.env, mounted read-only as /app/.env.
# API keys are read from this file by the collector, never from CLI arguments.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
KOSIS_API_KEY=
AIRKOREA_SERVICE_KEY=
YOUTHCENTER_API_KEY=
BIGKINDS_API_KEY=
# region-extract (P3): OpenAI-compatible model server. API key empty for a self-hosted server.
P3_LLM_BASE_URL=
P3_LLM_MODEL=
P3_LLM_API_KEY=
P3_LLM_WORKERS=4
# region-load (P3): place check (JUSO) and location (SGIS). Steps are skipped when empty.
JUSO_SEARCH_KEY=
SGIS_KEY=
SGIS_SECRET=
# embed-docs · embed-cards · score (P4)
GMS_API_KEY=
