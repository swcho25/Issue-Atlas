{
  "image_repository": "swcho25/issueatlas-backend",
  "collector_image_repository": "swcho25/issueatlas-backend",
  "registry_host": "docker.io",
  "project_url": "https://lab.ssafy.com/s15-final/S15P31C108",
  "environments": {
    "develop": {
      "app_dir": "/opt/issueatlas-dev",
      "health_url": "https://dev-backend.issue-atlas.kr/actuator/health",
      "local_health_url": "http://127.0.0.1:8080/actuator/health",
      "collector_env_file": "/etc/issueatlas/collector.env",
      "collector_input_dir": "/var/lib/issueatlas/collector/input",
      "collector_output_dir": "/var/lib/issueatlas/collector/output",
      "collector_log_dir": "/var/log/issueatlas/collector",
      "collector_network": "issueatlas-dev_default",
      "engine_image_repository": "swcho25/issueatlas-backend",
      "compose_files": [
        "compose.yaml",
        "compose.https.yaml",
        "compose.release.yaml"
      ],
      "frontend_image_repository": "swcho25/issueatlas-backend",
      "frontend_project": "issueatlas-development-frontend",
      "frontend_host_port": 3100,
      "frontend_network": "issueatlas-dev_default",
      "frontend_url": "https://dev.issue-atlas.kr"
    },
    "main": {
      "app_dir": "/opt/issueatlas-prod",
      "compose_files": [
        "compose.yaml",
        "compose.https.yaml",
        "compose.release.yaml"
      ],
      "health_url": "https://backend.issue-atlas.kr/actuator/health",
      "local_health_url": "http://127.0.0.1:8081/actuator/health",
      "collector_env_file": "/etc/issueatlas/production/collector.env",
      "collector_input_dir": "/var/lib/issueatlas/production/collector/input",
      "collector_output_dir": "/var/lib/issueatlas/production/collector/output",
      "collector_log_dir": "/var/log/issueatlas/production/collector",
      "collector_network": "issueatlas-prod_default",
      "frontend_image_repository": "swcho25/issueatlas-backend",
      "frontend_project": "issueatlas-production-frontend",
      "frontend_host_port": 3101,
      "frontend_network": "issueatlas-prod_default",
      "frontend_url": "https://issue-atlas.kr"
    }
  }
}
