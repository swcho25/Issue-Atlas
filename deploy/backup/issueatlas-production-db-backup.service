[Unit]
Description=IssueAtlas production database daily backup
Requires=docker.service
After=docker.service issueatlas-db-backup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/issueatlas-db-backup.py --environment production
User=root
UMask=0077
Environment=DOCKER_HOST=unix:///run/docker.sock
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=256M
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/issueatlas/daily/production
