    {
      "id": 8,
      "type": "row",
      "title": "서비스 상태 — 운영 FE는 아직 EC2 미배포",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "stat",
      "title": "HTTP health (1 정상 / 0 실패)",
      "datasource": {
        "type": "prometheus",
        "uid": "issueatlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"health\",environment=\"$environment\"}",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "실패",
                  "color": "red"
                },
                "1": {
                  "text": "정상",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Spring 지표 연결 (backend CD 후 활성)",
