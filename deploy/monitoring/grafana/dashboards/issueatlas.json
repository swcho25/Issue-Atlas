      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{job=\"node\",device=~\"ens.*|eth.*|enp.*\"}[$__rate_interval])",
          "legendFormat": "{{device}}",
          "instant": false
