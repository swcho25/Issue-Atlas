{
  "uid": "issueatlas-operations",
  "title": "IssueAtlas 운영 모니터링",
  "description": "273: 알림 없음. 지표 30초 간격/7일 보존. 운영 FE는 EC2 미배포이므로 HTTP 대상에서 제외. 요청이 없으면 응답 시간은 데이터 없음. Spring 지표는 해당 환경 backend CD 후 활성화.",
  "tags": [
    "issueatlas"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "custom",
        "query": "development,production",
        "current": {
          "text": "development",
          "value": "development"
        },
        "options": [
          {
            "text": "development",
            "value": "development",
            "selected": true
          },
          {
            "text": "production",
            "value": "production",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "EC2 전체 — 개발·운영·CI가 공유하는 자원",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "issueatlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "EC2",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "가용 메모리",
      "datasource": {
        "type": "prometheus",
        "uid": "issueatlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "가용",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "루트 디스크 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "issueatlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\",fstype!=\"rootfs\"})",
          "legendFormat": "/",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "디스크 I/O",
      "datasource": {
        "type": "prometheus",
        "uid": "issueatlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"node\",device=~\"nvme[0-9]+n[0-9]+|xvd[a-z]+|sd[a-z]+\"}[$__rate_interval]) + rate(node_disk_written_bytes_total{job=\"node\",device=~\"nvme[0-9]+n[0-9]+|xvd[a-z]+|sd[a-z]+\"}[$__rate_interval])",
          "legendFormat": "{{device}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "네트워크 수신",
      "datasource": {
        "type": "prometheus",
        "uid": "issueatlas-prometheus"
