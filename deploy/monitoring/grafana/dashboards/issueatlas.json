      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"spring\",environment=\"$environment\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"spring\",environment=\"$environment\",uri!~\"/actuator.*\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "5xx",
          "instant": false
