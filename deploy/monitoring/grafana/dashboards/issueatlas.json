      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "환경별 컨테이너 — 서비스 Docker만 수집, CI 부하는 EC2 전체 지표에 포함",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 12,
