# 실제 값은 서버의 .env에만 저장한다. 아래는 설정 이름 예시다.
DB_NAME=issue_atlas
DB_USERNAME=issueatlas
DB_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SSH tunnel HTTP development only. Set true before HTTPS deployment.
SESSION_COOKIE_SECURE=false
# 기존 개발 환경의 기본값. 운영은 issueatlas-prod / 5433,8081 / issueatlas-production-backend 사용
COMPOSE_PROJECT_NAME=issueatlas-dev
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
BACKEND_NETWORK_ALIAS=issueatlas-development-backend
# 논증 문장화 engine (S15P31C108-243). 비우면 backend 가 부르지 않는다.
# 켤 때 http://engine:8000 — 익명 질문 요청 수 제한이 배포된 뒤에만
ENGINE_URL=
# GMS_API_KEY 만 든 서버 파일 경로(키 값은 이 파일에 쓰지 않는다). 운영은 /etc/issueatlas/production/engine.env
ENGINE_ENV_FILE=/etc/issueatlas/engine.env
