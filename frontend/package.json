{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:preview": "opennextjs-cloudflare preview --port 8787",
    "worker:test": "playwright test --config playwright.worker.config.ts",
    "worker:deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint && steiger ./src && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "next build && playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "steiger": "0.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
