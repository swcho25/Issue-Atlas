{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "issueatlas-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "issueatlas-frontend" }],
  "routes": [{ "pattern": "issue-atlas.kr", "custom_domain": true }],
  "vars": {
    "API_BASE_URL": "https://backend.issue-atlas.kr",
    "DEPLOYMENT_REVISION": "local"
  }
}
