# 로컬 개발용 예시. 복사해서 .env 로 쓴다(.env 는 커밋하지 않는다).

# docker-compose.yml (PostGIS)
POSTGRES_PORT=5432
DB_NAME=issue_atlas
DB_USERNAME=postgres
DB_PASSWORD=atlaslocal

# backend (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5432/issue_atlas
SERVER_PORT=8080
# 첫 관리자 계정. 둘 다 있고 같은 이메일이 없을 때 서버 시작 시 한 번 만든다. 실제 값은 각자 .env 에만.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 세션 쿠키 Secure 속성. 로컬 http 는 false, 배포(https)는 true.
SESSION_COOKIE_SECURE=false

# frontend (Next.js 서버가 Spring API 를 부를 주소. 브라우저에 노출되지 않음)
API_BASE_URL=http://localhost:8080
# 목 API 서버(pnpm --filter frontend mock:api)를 쓰려면 API_BASE_URL=http://localhost:4010.
# 목 서버는 /v1/arguments/{계약 예시 run_id} 를 contracts/c2/examples 로 답하고, 나머지는 MOCK_UPSTREAM 으로 넘긴다
MOCK_PORT=4010
MOCK_UPSTREAM=https://dev.issue-atlas.kr/api

# P1 KOSIS 수집기. 키는 런타임에 이 .env에서만 읽는다(인자·환경 변수로 전달하지 않음).
KOSIS_API_KEY=
# Python 수집기의 PostgreSQL 호스트. 나머지는 위 DB_NAME/DB_USERNAME/DB_PASSWORD/POSTGRES_PORT 사용.
POSTGRES_HOST=localhost

# 에어코리아 측정소 API 공공데이터포털 인증키. Encoding/Decoding 키 모두 입력 가능.
AIRKOREA_SERVICE_KEY=
# 빅카인즈 OpenAPI access_key (뉴스 검색). 키는 런타임에 이 .env에서만 읽는다.
BIGKINDS_API_KEY=
# P3 기사 지역 · 요약 추출(region-extract)의 모델 서버. OpenAI 호환 /chat/completions 주소(…/v1)와 모델 이름.
# 자체 vLLM 서버면 키는 비운다. 둘 다 비어 있으면 추출을 하지 않는다. 동시 요청 수 기본 4
P3_LLM_BASE_URL=
P3_LLM_MODEL=
P3_LLM_API_KEY=
P3_LLM_WORKERS=
# P3 적재(region-load) 전 장소 확인: 행안부 도로명주소 검색 API 승인키(business.juso.go.kr 「검색 API」 신청). 비어 있으면 확인을 건너뛴다
JUSO_SEARCH_KEY=
# P3 적재(region-load) 때 기사 위치: 통계청 SGIS 오픈API 서비스 ID · 보안 키(sgis.kostat.go.kr). 둘 중 하나라도 비면 위치를 정하지 않는다
SGIS_KEY=
SGIS_SECRET=
# 온통청년 청년정책 OpenAPI 인증키(apiKeyNm). youthcenter.go.kr 오픈API 신청으로 받는다. 키는 런타임에 이 .env에서만 읽는다.
YOUTHCENTER_API_KEY=

# GMS API 키 — P4 기사→카드 분류(Gemini Embedding 2) · P5 논증 문장화(Gemini 2.5 Flash). 실행 시에만 읽고 로그에 남기지 않는다.
GMS_API_KEY=
